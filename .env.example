# ---- Clerk authentication (https://dashboard.clerk.com) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---- Database (server only - never prefix with NEXT_PUBLIC_) ----
# Neon, Supabase, RDS or local Postgres. Neon URLs use the serverless driver.
DATABASE_URL=postgresql://user:password@localhost:5432/qanda
# DB_DRIVER=neon|pg   # optional override

# ---- Gemini (server only - never prefix with NEXT_PUBLIC_) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- App settings ----
INTERVIEW_QUESTION_COUNT=5
MAX_INTERVIEWS_PER_DAY=10
MAX_ANSWERS_PER_DAY=100

# ---- Optional UI text and widgets (public) ----
NEXT_PUBLIC_INFORMATION=
NEXT_PUBLIC_QUESTION_NOTE=
NEXT_PUBLIC_CHATBASE_ID=
